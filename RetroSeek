#!/usr/bin/env python3
# =============================================================================
# RetroSeek: the launcher (ADR-020)
# =============================================================================
# A thin shim in front of workflow/scripts/RetroSeek.py. It exists for three
# things only:
#
#   1. `-h` and `--config-help` work without a config: they never import the
#      pipeline (`defaults.py` creates directories on import).
#   2. `--configfile` is made absolute and exported as RETROSEEK_CONFIG, so
#      `defaults.py` and Snakemake read the same file. The child runs with
#      cwd=workflow/, where a relative path would point elsewhere.
#   3. The child's exit code becomes ours, so a failed stage fails the command.
#
# The stage flags themselves live in one table, workflow/scripts/stages.py,
# which both this shim and the pipeline read.
# =============================================================================

import os
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent
sys.path.insert(0, str(REPO / "workflow" / "scripts"))
import stages  # noqa: E402  (needs the path above)


def absolute_configfile(argv: list[str]) -> tuple[list[str], str | None]:
    """Rewrite the first `--configfile X` (or `--configfile=X`) to an absolute path."""
    argv = list(argv)
    for i, token in enumerate(argv):
        if token == "--configfile" and i + 1 < len(argv):
            argv[i + 1] = str(Path(argv[i + 1]).resolve())
            return argv, argv[i + 1]
        if token.startswith("--configfile="):
            path = str(Path(token.split("=", 1)[1]).resolve())
            argv[i] = f"--configfile={path}"
            return argv, path
    return argv, None


def main() -> int:
    parser = stages.build_parser()
    args, _ = parser.parse_known_args()

    if hasattr(args, "config_help"):
        import config_help

        print(config_help.render(args.config_help))
        return 0

    if not stages.selected(args):
        parser.print_help()
        return 0

    argv, config = absolute_configfile(sys.argv[1:])

    # Without --configfile the pipeline reads data/config/config.yaml (example
    # data only). A RETROSEEK_CONFIG left in the shell must not leak in.
    env = {k: v for k, v in os.environ.items() if k != "RETROSEEK_CONFIG"}
    if config:
        env["RETROSEEK_CONFIG"] = config

    cmd = [sys.executable, "scripts/RetroSeek.py", *argv]
    try:
        return subprocess.run(cmd, cwd=REPO / "workflow", env=env, check=False).returncode
    except KeyboardInterrupt:
        # Ctrl-C reaches the child too (same process group); Snakemake stops its
        # jobs and marks unfinished files as incomplete. 130 = interrupted.
        return 130


if __name__ == "__main__":
    sys.exit(main())
