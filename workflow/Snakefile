                                       'refinement_funnel_aggregate',
                                       'multiplicity_m1_by_tier',
                                       'multiplicity_m2_global',
                                       'provirus_overlap_degree',
                                       'provirus_reciprocal_overlap',
                                       'provirus_reduction_fold',
                                       'provirus_coverage_before_after',
                                       'ltr_distance_to_retro',
                                       'ltr_position_within_provirus',
                                       'ltr_feature_breakdown',
                                       'ltr_strand_concordance',
                                       'ltr_probe_domain_overlap',
                                       'ltr_retro_length_vs_hits'])
    params:
        ranges_analysis_parquet_dir=defaults.PATH_DICT['RANGES_ANALYSIS_TABLES_PARQUET_DIR'],
        plot_dir=defaults.PATH_DICT['INTEGRATION_PLOT_DIR'],
        config_yaml=defaults.CONFIG_FILE
    threads:
        workflow.cores
    shell:
        '''
        Rscript scripts/stage_plot_generator.R \
        --input {params.ranges_analysis_parquet_dir:q} \
        --output {params.plot_dir:q} \
        --config {params.config_yaml:q}
        '''


rule stage_plot_generator:
    input:
        plots=rules.stage_plot_generator_setup.output


