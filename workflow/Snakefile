rule circle_plot_generator_setup:
    input:
        fasta=os.path.join(defaults.PATH_DICT['SPECIES_DB'], '{genome}.fa'),
        hits=os.path.join(defaults.PATH_DICT['TRACK_VALID_DIR'], '{genome}.gff3'),
        ltrdigest=os.path.join(defaults.PATH_DICT['LTRDIGEST_DIR'], '{genome}.gff3')
    output:
        circle_plot_png=os.path.join(defaults.PATH_DICT['CIRCLE_PLOT_DIR'], '{genome}.png'),
        circle_plot_pdf=os.path.join(defaults.PATH_DICT['CIRCLE_PLOT_DIR'], '{genome}.pdf')

    params:
        species_db=defaults.PATH_DICT['SPECIES_DB'],
        ltrdigest_dir=defaults.PATH_DICT['LTRDIGEST_DIR'],
        valid_tracks_dir=defaults.PATH_DICT['TRACK_VALID_DIR'],
        circle_plot_dir=defaults.PATH_DICT['CIRCLE_PLOT_DIR'],
        config_file=defaults.CONFIG_FILE
    threads:
        workflow.cores
    shell:
        '''
        Rscript scripts/circle_plot_generator.R \
        --fasta {params.species_db:q}/{wildcards.genome:q}.fa \
        --gff_custom {params.valid_tracks_dir:q}/{wildcards.genome:q}.gff3 \
        --gff_ltrdigest {params.ltrdigest_dir:q}/{wildcards.genome:q}.gff3 \
        --config {params.config_file:q} \
        --output {params.circle_plot_dir:q}/{wildcards.genome:q}
        '''

rule circle_plot_generator:
    input:
        circle_plots=lambda wildcards: expand(os.path.join(defaults.PATH_DICT['CIRCLE_PLOT_DIR'], '{genome}.png'),genome=species_with_hits(wildcards))


# Hotspot input-tier router: `hotspot.input` selects which upstream track feeds
# the detector. Each tier maps to (directory, per-genome filename) - note the
# `valid` tier uses the `_reduced.gff3` filename, `original` uses `{genome}.gff3`.
# (The retired erv_like tier is gone; the taxon-founded assembly is a separate
# stage and re-pointing hotspot at it is deferred to the hotspot rework.)
_HOTSPOT_INPUT = config.get('hotspot', {}).get('input', 'catalog')
# ADR-012: `catalog` counts one row per integration EVENT from the authoritative
# per-locus assembly, so a multi-gene provirus is one count rather than one per
# gene. It makes hotspot a consumer of the classification stage: Snakemake will
# pull taxonomy_classify in when catalog.csv is stale. `original` (raw tBLASTn
# hits) is kept for dense genome-wide calling, where the extra density is what
# gives the NB model power on sparse assemblies. The old `valid` tier is retired:
# it is the same events as `catalog`, multi-counted by gene content.
_HOTSPOT_TRACK = {
    'catalog':  (defaults.PATH_DICT['TAXONOMY_TABLES_CSV_DIR'], 'catalog.csv'),
    'original': (defaults.PATH_DICT['TRACK_ORIGINAL_DIR'],      '{genome}.gff3'),
}
if _HOTSPOT_INPUT not in _HOTSPOT_TRACK:
    raise ValueError(
        f"hotspot.input must be one of {sorted(_HOTSPOT_TRACK)}; got {_HOTSPOT_INPUT!r}"
    )
_HOTSPOT_INPUT_DIR, _HOTSPOT_INPUT_FILE = _HOTSPOT_TRACK[_HOTSPOT_INPUT]


# =============================================================================
# 7. HOTSPOT & PAIR DETECTION
#    NB-GLM detection of integration hotspots, and tBLASTn<->LTRdigest pair overlaps.
# =============================================================================
rule hotspot_detector_setup:
    input:
        # Per-genome scoping (A5): declare the genome FASTA + the selected input
        # track directly so Snakemake schedules the rule per-{genome}. The input
        # track tier is chosen by `hotspot.input` (see router above).
        fasta = os.path.join(defaults.PATH_DICT['SPECIES_DB'], '{genome}.fa'),
        track = os.path.join(_HOTSPOT_INPUT_DIR, _HOTSPOT_INPUT_FILE)
    output:
        hotspot_csv=os.path.join(defaults.PATH_DICT['HOTSPOT_CSV_DIR'], '{genome}.csv'),
        hotspot_regions=os.path.join(defaults.PATH_DICT['HOTSPOT_CSV_DIR'], '{genome}.hotspots.csv'),
        hotspot_parquet=os.path.join(defaults.PATH_DICT['HOTSPOT_PARQUET_DIR'], '{genome}.parquet'),
        hotspot_manifest=os.path.join(defaults.PATH_DICT['HOTSPOT_PARQUET_DIR'], '{genome}.manifest.yaml'),
        hotspot_manhattan_pdf=os.path.join(defaults.PATH_DICT['HOTSPOT_PLOT_DIR'], '{genome}_manhattan.pdf'),
        hotspot_karyotype_pdf=os.path.join(defaults.PATH_DICT['HOTSPOT_PLOT_DIR'], '{genome}_karyotype.pdf'),
        hotspot_qq_pdf=os.path.join(defaults.PATH_DICT['HOTSPOT_PLOT_DIR'], '{genome}_qq.pdf'),
        hotspot_summary_pdf=os.path.join(defaults.PATH_DICT['HOTSPOT_PLOT_DIR'], '{genome}_summary.pdf'),
        hotspot_composition_pdf=os.path.join(defaults.PATH_DICT['HOTSPOT_PLOT_DIR'], '{genome}_composition.pdf'),
        hotspot_track=os.path.join(defaults.PATH_DICT['TRACK_HOTSPOTS_DIR'], '{genome}.gff3'),
        hotspot_bed=os.path.join(defaults.PATH_DICT['TRACK_HOTSPOTS_DIR'], '{genome}.bed')
    params:
        csv_dir=defaults.PATH_DICT['HOTSPOT_CSV_DIR'],
        parquet_dir=defaults.PATH_DICT['HOTSPOT_PARQUET_DIR'],
        pdf_dir=defaults.PATH_DICT['HOTSPOT_PLOT_DIR'],
        track_dir=defaults.PATH_DICT['TRACK_HOTSPOTS_DIR'],
        config_yaml = defaults.CONFIG_FILE
    threads:
        workflow.cores
    shell:
        '''
        Rscript scripts/hotspot_detector.R \
        --fasta {input.fasta:q} \
        --hits {input.track:q} \
        --config {params.config_yaml:q} \
        --parquet_dir {params.parquet_dir:q} \
        --csv_dir {params.csv_dir:q} \
        --track_output_dir {params.track_dir:q} \
        --pdf_output_dir {params.pdf_dir:q}
        '''

rule hotspot_detector:
    input:
        hotspot_csv=lambda wildcards: expand(os.path.join(defaults.PATH_DICT['HOTSPOT_CSV_DIR'], '{genome}.csv'), genome=species_with_hits(wildcards)),
        hotspot_manhattan_pdf=lambda wildcards: expand(os.path.join(defaults.PATH_DICT['HOTSPOT_PLOT_DIR'], '{genome}_manhattan.pdf'), genome=species_with_hits(wildcards)),
        hotspot_karyotype_pdf=lambda wildcards: expand(os.path.join(defaults.PATH_DICT['HOTSPOT_PLOT_DIR'], '{genome}_karyotype.pdf'), genome=species_with_hits(wildcards)),
        hotspot_qq_pdf=lambda wildcards: expand(os.path.join(defaults.PATH_DICT['HOTSPOT_PLOT_DIR'], '{genome}_qq.pdf'), genome=species_with_hits(wildcards)),
        hotspot_summary_pdf=lambda wildcards: expand(os.path.join(defaults.PATH_DICT['HOTSPOT_PLOT_DIR'], '{genome}_summary.pdf'), genome=species_with_hits(wildcards)),
        hotspot_track=lambda wildcards: expand(os.path.join(defaults.PATH_DICT['TRACK_HOTSPOTS_DIR'], '{genome}.gff3'), genome=species_with_hits(wildcards))


rule pair_detector_setup:
    input:
        gff3_file=os.path.join(defaults.PATH_DICT['TRACK_VALID_DIR'], '{genome}.gff3'),
    output:
        pair_table_csv=os.path.join(defaults.PATH_DICT['PROBE_PAIRS_CSV_DIR'], '{genome}.csv'),
        pair_table_parquet=os.path.join(defaults.PATH_DICT['PROBE_PAIRS_PARQUET_DIR'], '{genome}.parquet')
    params:
        config_yaml=defaults.CONFIG_FILE,
        parquet_dir=defaults.PATH_DICT['PROBE_PAIRS_PARQUET_DIR'],
        csv_dir=defaults.PATH_DICT['PROBE_PAIRS_CSV_DIR']
    threads:
        workflow.cores
    shell:
        '''
        Rscript scripts/pair_detector.R \
        --config {params.config_yaml:q} \
        --gff {input.gff3_file:q} \
        --parquet_dir {params.parquet_dir:q} \
        --csv_dir {params.csv_dir:q}
        '''

rule pair_detector:
    input:
        pair_table_csv=lambda wildcards: expand(os.path.join(defaults.PATH_DICT['PROBE_PAIRS_CSV_DIR'], '{genome}.csv'), genome=species_with_hits(wildcards)),
        pair_table_parquet=lambda wildcards: expand(os.path.join(defaults.PATH_DICT['PROBE_PAIRS_PARQUET_DIR'], '{genome}.parquet'), genome=species_with_hits(wildcards))


# ----------------------------- Taxonomic classification ----------------------
# Per-locus ERV taxon calls (rank-agnostic axis; ADR-008): each valid LTR-element
# locus is reclassified from its own marker sequence against a pinned,
# taxon-comprehensive reference - POL/GAG by phylogenetic placement, weighted-LCA
# otherwise - replacing best-bitscore probe-label transfer. The loci table is the
# taxon-founded ERV assembly (consensus taxon_call + rank + mosaic + structure). See
# docs/configuration.md (`classification`), docs/taxonomy_classification/, and the ADRs.
_CLASSIFICATION = config.get('classification', {})
_PLACEMENT = config.get('placement', {}) or {}
_PLACEMENT_GENES = [g.upper() for g in _CLASSIFICATION.get('placement_genes', ['POL'])]
_MAIN_PROBES = ",".join(config['parameters'].get('main_probes', []))
_TAX_SEED = config['parameters'].get('seed', 0)
# Classification axis (ADR-008, rank-agnostic): explicit reference_taxa (any rank)
# override the default, which is the distinct probeset Label values (via --probe-csv).
_REFERENCE_TAXA = ",".join(_CLASSIFICATION.get('reference_taxa', []) or [])
_PROBE_CSV = config['input']['probe_csv']


# Build the reference package: taxon-comprehensive proteins + accession->taxon/gene
# table (Entrez), NCBI-derived taxonomy.tsv, the curated erv_class.tsv (copied from
# the tracked source), and a provenance manifest. Network rule; build-once cache,
# rebuilt only if outputs are missing (mirrors pfam_hmm_downloader).
# =============================================================================
# 8. TAXONOMIC CLASSIFICATION - per-locus taxon calls (rank-agnostic axis)
#    build the taxon-comprehensive reference + placement trees, classify LTR-flanked
#    loci, recover + classify the orphans tier, and render the taxonomy panel.
# =============================================================================
rule taxonomy_reference:
    output:
        faa       = os.path.join(defaults.PATH_DICT['TAXONOMY_REFERENCE_DIR'], 'retro_reference.faa'),
        csv       = os.path.join(defaults.PATH_DICT['TAXONOMY_REFERENCE_DIR'], 'retro_reference.csv'),
        taxonomy  = os.path.join(defaults.PATH_DICT['TAXONOMY_REFERENCE_DIR'], 'taxonomy.tsv'),
        erv_class = os.path.join(defaults.PATH_DICT['TAXONOMY_REFERENCE_DIR'], 'erv_class.tsv'),
        manifest  = os.path.join(defaults.PATH_DICT['TAXONOMY_REFERENCE_DIR'], 'manifest.yaml')
    params:
        ref_dir        = defaults.PATH_DICT['TAXONOMY_REFERENCE_DIR'],
        email          = defaults.ENTREZ_EMAIL,
        reference_taxa = _REFERENCE_TAXA,
        probe_csv      = _PROBE_CSV,
        erv_class_src  = os.path.join(defaults.PATH_DICT['CONFIG_DIR'], 'erv_class.tsv')
    threads: 1
    shell:
        '''
        PYTHONPATH=scripts python scripts/taxonomy/taxonomy_reference_builder.py --email {params.email:q} --out-dir {params.ref_dir:q} \
            --taxa {params.reference_taxa:q} --probe-csv {params.probe_csv:q} && \
        PYTHONPATH=scripts python scripts/taxonomy/taxonomy_build_hierarchy.py {output.csv:q} {params.email:q} && \
        cp {params.erv_class_src:q} {output.erv_class:q}
        '''


# Per-placement-gene tree package (MAFFT -> IQ-TREE -> raxml-ng --evaluate ->
# hmmbuild -> taxon map). Seeded from parameters.seed for byte-reproducible trees.
rule taxonomy_reference_trees_setup:
    input:
        faa      = rules.taxonomy_reference.output.faa,
        csv      = rules.taxonomy_reference.output.csv,
        taxonomy = rules.taxonomy_reference.output.taxonomy
    output:
        afa        = os.path.join(defaults.PATH_DICT['TAXONOMY_TREES_DIR'], '{gene}.afa'),
        treefile   = os.path.join(defaults.PATH_DICT['TAXONOMY_TREES_DIR'], '{gene}.treefile'),
        best_model = os.path.join(defaults.PATH_DICT['TAXONOMY_TREES_DIR'], '{gene}.raxml.bestModel'),
        best_tree  = os.path.join(defaults.PATH_DICT['TAXONOMY_TREES_DIR'], '{gene}.raxml.bestTree'),
        hmm        = os.path.join(defaults.PATH_DICT['TAXONOMY_TREES_DIR'], '{gene}.hmm'),
        taxon      = os.path.join(defaults.PATH_DICT['TAXONOMY_TREES_DIR'], '{gene}.taxon.tsv')
    params:
        ref_dir = defaults.PATH_DICT['TAXONOMY_REFERENCE_DIR'],
        seed    = _TAX_SEED
    wildcard_constraints:
        gene = "[A-Za-z0-9]+"
    threads: config.get('rule_threads', 2)
    shell:
        '''
        PYTHONPATH=scripts python scripts/taxonomy/taxonomy_build_tree.py {wildcards.gene} \
            --ref-dir {params.ref_dir:q} --seed {params.seed} --threads {threads}
        '''


# `make reference` target - full reference package + every placement-gene tree.
rule taxonomy_reference_trees:
    input:
        expand(os.path.join(defaults.PATH_DICT['TAXONOMY_TREES_DIR'], '{gene}.raxml.bestTree'),
               gene=_PLACEMENT_GENES),
        rules.taxonomy_reference.output.manifest


rule taxonomy_classify_setup:
    input:
        valid     = os.path.join(defaults.PATH_DICT['TRACK_VALID_DIR'], '{genome}.gff3'),
        genome    = os.path.join(defaults.PATH_DICT['SPECIES_DB'], '{genome}.fa'),
        faa       = rules.taxonomy_reference.output.faa,
        csv       = rules.taxonomy_reference.output.csv,
        taxonomy  = rules.taxonomy_reference.output.taxonomy,
        erv_class = rules.taxonomy_reference.output.erv_class,
        trees     = expand(os.path.join(defaults.PATH_DICT['TAXONOMY_TREES_DIR'], '{gene}.raxml.bestTree'),
                           gene=_PLACEMENT_GENES)
    output:
        loci_parquet = os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_PARQUET_DIR'], '{genome}.loci.parquet'),
        loci_csv     = os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_CSV_DIR'], '{genome}.loci.csv'),
        counts_csv   = os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_CSV_DIR'], '{genome}.classification_counts.csv'),
        gff3         = os.path.join(defaults.PATH_DICT['TRACK_TAXONOMY_DIR'], '{genome}.gff3'),
        bed          = os.path.join(defaults.PATH_DICT['TRACK_TAXONOMY_DIR'], '{genome}.bed'),
        # Placement evidence (ADR-014): EPA-ng writes these into TMP_DIR, which is
        # cleared between runs. They are the evidence behind every taxon_call, so
        # they are declared outputs here. A genome with no placeable queries still
        # gets a valid empty jplace, so the DAG holds either way.
        placements   = expand(
            os.path.join(defaults.PATH_DICT['PLACEMENT_DIR'], '{{genome}}.ltr-flanked.{gene}.{ext}'),
            gene=_PLACEMENT_GENES, ext=['jplace', 'labelled.newick']
        )
    params:
        ref_dir         = defaults.PATH_DICT['TAXONOMY_REFERENCE_DIR'],
        main_probes     = _MAIN_PROBES,
        placement_genes = ",".join(_PLACEMENT_GENES),
        evalue          = _CLASSIFICATION.get('evalue', 0.001),
        top_percent     = _CLASSIFICATION.get('top_percent', 0.10),
        min_orf         = _CLASSIFICATION.get('min_orf', 30),
        confidence_min  = _CLASSIFICATION.get('confidence_min', 0.5),
        structure_full_min = _CLASSIFICATION.get('structure_full_min', 1.0),
        segment_rank = _CLASSIFICATION.get('segment_rank', 'genus'),
        workdir         = os.path.join(defaults.PATH_DICT['TMP_DIR'], 'taxonomy'),
        placement_dir   = defaults.PATH_DICT['PLACEMENT_DIR']
    threads: config.get('rule_threads', 1)
    shell:
        '''
        PYTHONPATH=scripts python scripts/taxonomy/taxonomy_classify_loci.py {input.valid:q} {input.genome:q} \
            --ref-dir {params.ref_dir:q} \
            --main-probes {params.main_probes:q} \
            --placement-genes {params.placement_genes:q} \
            --evalue {params.evalue} --top-percent {params.top_percent} --min-orf {params.min_orf} \
            --confidence-min {params.confidence_min} --structure-full-min {params.structure_full_min} --segment-rank {params.segment_rank:q} --source ltr-flanked \
            --out-placement-dir {params.placement_dir:q} \
            --threads {threads} \
            --workdir {params.workdir:q}/{wildcards.genome:q} \
            --out-parquet {output.loci_parquet:q} --out-csv {output.loci_csv:q} \
            --out-counts {output.counts_csv:q} \
            --out-gff3 {output.gff3:q} --out-bed {output.bed:q}
        '''


# Aggregate target. Honours `classification.enable`: when false, demands nothing
# (the stage is skipped and the pipeline keeps legacy probe-label provenance only).
rule taxonomy_classify:
    input:
        loci = lambda wildcards: (
            expand(os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_PARQUET_DIR'], '{genome}.loci.parquet'),
                   genome=species_with_hits(wildcards))
            if _CLASSIFICATION.get('enable', True) else []),
        tracks = lambda wildcards: (
            expand(os.path.join(defaults.PATH_DICT['TRACK_TAXONOMY_DIR'], '{genome}.gff3'),
                   genome=species_with_hits(wildcards))
            if _CLASSIFICATION.get('enable', True) else []),
        # Demand the placement evidence too, so it is genuinely produced rather
        # than merely declarable. Without this the setup rule is never scheduled
        # when its table outputs are already current, and the jplace stays in the
        # scratch dir where it gets cleared (ADR-014).
        placements = lambda wildcards: (
            expand(os.path.join(defaults.PATH_DICT['PLACEMENT_DIR'], '{genome}.ltr-flanked.{gene}.jplace'),
                   genome=species_with_hits(wildcards), gene=_PLACEMENT_GENES)
            if _CLASSIFICATION.get('enable', True) else [])


# Orphans tier - recover non-LTR-associated orphans by running the SAME
# classifier on the orphans GFF3 (parentless features -> singleton loci), gated
# to keep only orphans that earned a taxonomic call (--gate-classified). The
# orphans table shares the loci schema (source='orphan') so the report unions
# the two tiers.
rule taxonomy_orphans_setup:
    input:
        orphans = os.path.join(defaults.PATH_DICT['TRACK_ORPHANS_DIR'], '{genome}.gff3'),
        genome    = os.path.join(defaults.PATH_DICT['SPECIES_DB'], '{genome}.fa'),
        faa       = rules.taxonomy_reference.output.faa,
        csv       = rules.taxonomy_reference.output.csv,
        taxonomy  = rules.taxonomy_reference.output.taxonomy,
        erv_class = rules.taxonomy_reference.output.erv_class,
        trees     = expand(os.path.join(defaults.PATH_DICT['TAXONOMY_TREES_DIR'], '{gene}.raxml.bestTree'),
                           gene=_PLACEMENT_GENES)
    output:
        loci_parquet = os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_PARQUET_DIR'], '{genome}.orphans.parquet'),
        loci_csv     = os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_CSV_DIR'], '{genome}.orphans.csv'),
        counts_csv   = os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_CSV_DIR'], '{genome}.orphans_counts.csv'),
        gff3         = os.path.join(defaults.PATH_DICT['TRACK_ORPHANS_DIR'], '{genome}.classified.gff3'),
        bed          = os.path.join(defaults.PATH_DICT['TRACK_ORPHANS_DIR'], '{genome}.classified.bed'),
        # Placement evidence for the orphan tier (ADR-014); see the LTR-flanked
        # rule above. Whether the weaker tier places the same way as the
        # LTR-confirmed one is itself a useful check.
        placements   = expand(
            os.path.join(defaults.PATH_DICT['PLACEMENT_DIR'], '{{genome}}.orphan.{gene}.{ext}'),
            gene=_PLACEMENT_GENES, ext=['jplace', 'labelled.newick']
        )
    params:
        ref_dir         = defaults.PATH_DICT['TAXONOMY_REFERENCE_DIR'],
        main_probes     = _MAIN_PROBES,
        placement_genes = ",".join(_PLACEMENT_GENES),
        evalue          = _CLASSIFICATION.get('evalue', 0.001),
        top_percent     = _CLASSIFICATION.get('top_percent', 0.10),
        min_orf         = _CLASSIFICATION.get('min_orf', 30),
        confidence_min  = _CLASSIFICATION.get('confidence_min', 0.5),
        structure_full_min = _CLASSIFICATION.get('structure_full_min', 1.0),
        segment_rank = _CLASSIFICATION.get('segment_rank', 'genus'),
        workdir         = os.path.join(defaults.PATH_DICT['TMP_DIR'], 'orphans'),
        placement_dir   = defaults.PATH_DICT['PLACEMENT_DIR']
    threads: config.get('rule_threads', 1)
    shell:
        '''
        PYTHONPATH=scripts python scripts/taxonomy/taxonomy_classify_loci.py {input.orphans:q} {input.genome:q} \
            --ref-dir {params.ref_dir:q} \
            --main-probes {params.main_probes:q} \
            --placement-genes {params.placement_genes:q} \
            --evalue {params.evalue} --top-percent {params.top_percent} --min-orf {params.min_orf} \
            --confidence-min {params.confidence_min} --structure-full-min {params.structure_full_min} --segment-rank {params.segment_rank:q} --source orphan --gate-classified \
            --out-placement-dir {params.placement_dir:q} \
            --threads {threads} \
            --workdir {params.workdir:q}/{wildcards.genome:q} \
            --out-parquet {output.loci_parquet:q} --out-csv {output.loci_csv:q} \
            --out-counts {output.counts_csv:q} \
            --out-gff3 {output.gff3:q} --out-bed {output.bed:q}
        '''


rule taxonomy_orphans:
    input:
        loci = lambda wildcards: (
            expand(os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_PARQUET_DIR'], '{genome}.orphans.parquet'),
                   genome=species_with_hits(wildcards))
            if _CLASSIFICATION.get('enable', True) else []),
        tracks = lambda wildcards: (
            expand(os.path.join(defaults.PATH_DICT['TRACK_ORPHANS_DIR'], '{genome}.classified.gff3'),
                   genome=species_with_hits(wildcards))
            if _CLASSIFICATION.get('enable', True) else []),
        placements = lambda wildcards: (
            expand(os.path.join(defaults.PATH_DICT['PLACEMENT_DIR'], '{genome}.orphan.{gene}.jplace'),
                   genome=species_with_hits(wildcards), gene=_PLACEMENT_GENES)
            if _CLASSIFICATION.get('enable', True) else [])


# Taxonomy plot panel - taxon composition, rank/method resolution, mosaic. Derived
# from the loci tables (so plots and tables are concordant by construction).
# =============================================================================
# 8b. TAXONOMY TREE LAYOUT - flat coordinates for the tree-attached panels
#     Builds the taxon cladogram from the reference taxonomy hierarchy and, when
#     the user pinned one, prunes their host-species Newick to the study's
#     species. Emits x/y CSVs so the R panels draw trees without an R tree
#     library (Bio.Phylo does the work; biopython is already a dependency).
#     Reads the per-genome loci/orphan parquets - NOT catalog.csv, which is an
#     OUTPUT of the plot stage, so depending on it here would cycle.
# =============================================================================
rule taxonomy_tree_layout_setup:
    input:
        loci = lambda wildcards: expand(os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_PARQUET_DIR'], '{genome}.loci.parquet'),
                                        genome=species_with_hits(wildcards)),
        orphans = lambda wildcards: expand(os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_PARQUET_DIR'], '{genome}.orphans.parquet'),
                                           genome=species_with_hits(wildcards))
    output:
        coords = expand(os.path.join(defaults.PATH_DICT['TAXONOMY_TREE_COORDS_DIR'], '{tree}.tree_{part}.csv'),
                        tree=['taxon', 'species'], part=['segments', 'tips'])
    params:
        parquet_dir  = defaults.PATH_DICT['TAXONOMY_TABLES_PARQUET_DIR'],
        out_dir      = defaults.PATH_DICT['TAXONOMY_TREE_COORDS_DIR'],
        taxonomy_tsv = os.path.join(defaults.PATH_DICT['TAXONOMY_REFERENCE_DIR'], 'taxonomy.tsv'),
        config_yaml  = defaults.CONFIG_FILE,
        species_tree = (config.get('input', {}) or {}).get('species_tree', '') or ''
    log:
        os.path.join(defaults.PATH_DICT['LOG_DIR'], 'taxonomy_tree_layout', 'tree_layout.log')
    shell:
        '''
        set -euo pipefail
        mkdir -p "$(dirname {log:q})"
        PYTHONPATH=scripts python scripts/taxonomy/tree_layout.py \
        --parquet-dir {params.parquet_dir:q} \
        --taxonomy-tsv {params.taxonomy_tsv:q} \
        --out-dir {params.out_dir:q} \
        --config {params.config_yaml:q} \
        $( [ -n "{params.species_tree}" ] && echo --species-tree "{params.species_tree}" ) \
        2> {log:q}
        '''


rule taxonomy_tree_layout:
    input:
        coords = rules.taxonomy_tree_layout_setup.output.coords


rule taxonomy_plot_generator_setup:
    input:
        loci = lambda wildcards: expand(os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_PARQUET_DIR'], '{genome}.loci.parquet'),
                                        genome=species_with_hits(wildcards)),
        orphans = lambda wildcards: expand(os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_PARQUET_DIR'], '{genome}.orphans.parquet'),
                                             genome=species_with_hits(wildcards)),
        trees = rules.taxonomy_tree_layout_setup.output.coords
    output:
        plots = expand(os.path.join(defaults.PATH_DICT['TAXONOMY_PLOT_DIR'], '{tax_plot}.png'),
                       tax_plot=['taxon_composition',
                                 'rank_resolution',
                                 'method_mix',
                                 'erv_class_composition',
                                 'mosaic_alluvial',
                                 'confidence',
                                 'evidence_depth',
                                 'confidence_density',
                                 'confidence_vs_evidence',
                                 'structure_by_tier',
                                 'source_yield',
                                 'taxon_by_source',
                                 'domain_tier_composition',
                                 'structure_class_composition',
                                 'mosaic_burden',
                                 'mosaic_taxon_pairs',
                                 'mosaic_gene_discordance',
                                 'mosaic_composition_by_species',
                                 'confidence_count',
                                 'confidence_gradient',
                                 'taxon_confidence_tree',
                                 'species_confidence_tree',
                                 'species_composition_tree',
                                 'taxon_tier_tree']),
        report = os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_CSV_DIR'], 'classification_report.csv'),
        catalog = os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_CSV_DIR'], 'catalog.csv')
    params:
        parquet_dir = defaults.PATH_DICT['TAXONOMY_TABLES_PARQUET_DIR'],
        plot_dir    = defaults.PATH_DICT['TAXONOMY_PLOT_DIR'],
        tree_dir    = defaults.PATH_DICT['TAXONOMY_TREE_COORDS_DIR'],
        config_yaml = defaults.CONFIG_FILE
    threads:
        workflow.cores
    shell:
        '''
        Rscript scripts/taxonomy/taxonomy_plot_generator.R \
        --input {params.parquet_dir:q} \
        --output {params.plot_dir:q} \
        --config {params.config_yaml:q} \
        --tree_dir {params.tree_dir:q} \
        --report_csv {output.report:q} \
        --catalog_csv {output.catalog:q}
        '''


rule taxonomy_plot_generator:
    input:
        plots=rules.taxonomy_plot_generator_setup.output


# Unified loss funnel - UNIONs the ranges-analysis counts with the blastx-stage
# classification + orphans counts into one per-stage attrition table, exports
# the per-genome novel candidates (loci with zero blastx homology), and renders
# the funnel plot. Aggregate rule: demands every genome's counts + loci so the
# funnel is complete.
# =============================================================================
# 8c. TAXONOMY SEGMENTS - split the authoritative catalog by taxonomic segment
#     Each locus already carries `segment` (its ancestor at
#     classification.segment_rank, or unassigned_at_<rank>), derived in the
#     classifier from the reference hierarchy - so this stage is a pure split
#     plus a curated per-segment plot subset. Rank-agnostic: set segment_rank to
#     family and the same code segments by family.
# =============================================================================
rule taxonomy_segments_setup:
    input:
        catalog = rules.taxonomy_plot_generator_setup.output.catalog
    output:
        summary = os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_CSV_DIR'], 'segment_summary.csv')
    params:
        out_dir     = defaults.PATH_DICT['TAXONOMY_SEGMENTS_DIR'],
        config_yaml = defaults.CONFIG_FILE
    shell:
        '''
        Rscript scripts/taxonomy/taxonomy_segments.R \
        --catalog {input.catalog:q} \
        --output {params.out_dir:q} \
        --config {params.config_yaml:q} \
        --summary_csv {output.summary:q}
        '''


rule taxonomy_segments:
    input:
        summary = rules.taxonomy_segments_setup.output.summary


# =============================================================================
# 8d. PHYLOGENETIC PLACEMENT FIGURES (ADR-014)
#     EPA-ng already places every locus onto the retroviral reference tree, and
#     taxonomy_classify/taxonomy_orphans now publish that evidence. These rules
#     turn it into figures the catalog cannot express: where a genome's ERV load
#     sits on the phylogeny, how certain each placement is, and whether ERV
#     complements track host ancestry.
# =============================================================================
# Tiers are the two catalog sources; the wildcard is constrained so `{tier}`
# cannot swallow part of a genome name.
wildcard_constraints:
    tier = "ltr-flanked|orphan"


rule placement_figures_setup:
    input:
        jplace = os.path.join(defaults.PATH_DICT['PLACEMENT_DIR'], '{genome}.{tier}.{gene}.jplace')
    output:
        # gappa core-dumps on a placement-free jplace ("Invalid Color
        # Normalization"), so the script gates on the placement count and writes
        # an empty-state SVG instead. This output therefore always materialises.
        heat_tree = os.path.join(defaults.PATH_DICT['PLACEMENT_PLOT_DIR'], '{genome}.{tier}.{gene}.tree.svg')
    log:
        os.path.join(defaults.PATH_DICT['LOG_DIR'], 'placement_figures', '{genome}.{tier}.{gene}.log')
    params:
        out_dir   = defaults.PATH_DICT['PLACEMENT_PLOT_DIR'],
        table_dir = defaults.PATH_DICT['PLACEMENT_TABLE_DIR'],
        tree_dir  = defaults.PATH_DICT['PLACEMENT_DIR'],
        mass_norm = _PLACEMENT.get('mass_norm', 'absolute')
    threads: 1
    shell:
        '''
        PYTHONPATH=scripts python scripts/taxonomy/placement_figures.py \
            --jplace {input.jplace:q} \
            --out-dir {params.out_dir:q} \
            --table-dir {params.table_dir:q} \
            --tree-dir {params.tree_dir:q} \
            --stem {wildcards.genome:q}.{wildcards.tier:q}.{wildcards.gene:q} \
            --mass-norm {params.mass_norm} \
            2> {log:q}
        '''


rule placement_figures:
    input:
        heat_trees = lambda wildcards: expand(
            os.path.join(defaults.PATH_DICT['PLACEMENT_PLOT_DIR'], '{genome}.{tier}.{gene}.tree.svg'),
            genome=species_with_hits(wildcards), tier=['ltr-flanked', 'orphan'],
            gene=_PLACEMENT_GENES
        )


# Cross-genome comparison, one invocation per tier. Whether the weaker orphan
# tier tells the same story as the LTR-confirmed one is itself a useful check,
# so they are never pooled.
rule placement_cophylogeny_setup:
    input:
        jplace = lambda wildcards: expand(
            os.path.join(defaults.PATH_DICT['PLACEMENT_DIR'], '{genome}.{{tier}}.{{gene}}.jplace'),
            genome=species_with_hits(wildcards)
        )
    output:
        summary = os.path.join(defaults.PATH_DICT['COPHYLOGENY_DIR'], 'cophylogeny_summary.{tier}.{gene}.csv')
    log:
        os.path.join(defaults.PATH_DICT['LOG_DIR'], 'placement_cophylogeny', '{tier}.{gene}.log')
    params:
        out_dir    = defaults.PATH_DICT['COPHYLOGENY_DIR'],
        host_tree  = (config.get('input', {}) or {}).get('species_tree', '') or '',
        staged_dir = os.path.join(defaults.PATH_DICT['TMP_DIR'], 'cophylogeny', '{tier}_{gene}'),
        config_yaml = defaults.CONFIG_FILE
    threads: 1
    shell:
        '''
        PYTHONPATH=scripts python scripts/taxonomy/placement_cophylogeny.py \
            --jplace {input.jplace:q} \
            --out-dir {params.out_dir:q} \
            --tier {wildcards.tier:q} \
            --gene {wildcards.gene:q} \
            --staged-dir {params.staged_dir:q} \
            --config {params.config_yaml:q} \
            $( [ -n "{params.host_tree}" ] && echo --host-tree "{params.host_tree}" ) \
            2> {log:q}
        '''


rule placement_cophylogeny:
    input:
        summaries = expand(
            os.path.join(defaults.PATH_DICT['COPHYLOGENY_DIR'], 'cophylogeny_summary.{tier}.{gene}.csv'),
            tier=['ltr-flanked', 'orphan'], gene=_PLACEMENT_GENES
        )


# Top-level target for --placement-trees. The expands are repeated rather than
# referencing rules.placement_figures.input: that attribute is a lambda (it
# resolves species_with_hits at runtime), and Snakemake cannot dereference
# another rule's input function from a rule body.
rule placement_trees:
    input:
        figures = lambda wildcards: expand(
            os.path.join(defaults.PATH_DICT['PLACEMENT_PLOT_DIR'], '{genome}.{tier}.{gene}.tree.svg'),
            genome=species_with_hits(wildcards), tier=['ltr-flanked', 'orphan'],
            gene=_PLACEMENT_GENES
        ),
        cophylogeny = expand(
            os.path.join(defaults.PATH_DICT['COPHYLOGENY_DIR'], 'cophylogeny_summary.{tier}.{gene}.csv'),
            tier=['ltr-flanked', 'orphan'], gene=_PLACEMENT_GENES
        )


# =============================================================================
# 9. LOSS ANALYSIS - per-stage funnel + novel candidates
#    union the ranges-analysis and blastx-stage counts into one attrition funnel,
#    export per-genome novel candidates, and render the loss panel.
# =============================================================================
rule loss_analysis_setup:
    input:
        ranges_counts = lambda wildcards: expand(
            os.path.join(defaults.PATH_DICT['RANGES_ANALYSIS_TABLES_CSV_DIR'], '{genome}.counts.csv'),
            genome=species_with_hits(wildcards)),
        class_counts = lambda wildcards: (
            expand(os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_CSV_DIR'], '{genome}.classification_counts.csv'),
                   genome=species_with_hits(wildcards))
            if _CLASSIFICATION.get('enable', True) else []),
        frag_counts = lambda wildcards: (
            expand(os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_CSV_DIR'], '{genome}.orphans_counts.csv'),
                   genome=species_with_hits(wildcards))
            if _CLASSIFICATION.get('enable', True) else []),
        loci = lambda wildcards: (
            expand(os.path.join(defaults.PATH_DICT['TAXONOMY_TABLES_PARQUET_DIR'], '{genome}.loci.parquet'),
                   genome=species_with_hits(wildcards))
            if _CLASSIFICATION.get('enable', True) else [])
    output:
        table_parquet = os.path.join(defaults.PATH_DICT['LOSS_ANALYSIS_PARQUET_DIR'], 'loss_analysis.parquet'),
        table_csv     = os.path.join(defaults.PATH_DICT['LOSS_ANALYSIS_CSV_DIR'], 'loss_analysis.csv'),
        plots         = expand(os.path.join(defaults.PATH_DICT['LOSS_PLOT_DIR'], '{loss_plot}.png'),
                               loss_plot=['loss_funnel',
                                          'step_retention',
                                          'orphan_recovery',
                                          'novel_burden',
                                          'loss_waterfall'])
    params:
        ranges_counts_dir = defaults.PATH_DICT['RANGES_ANALYSIS_TABLES_CSV_DIR'],
        class_counts_dir  = defaults.PATH_DICT['TAXONOMY_TABLES_CSV_DIR'],
        loci_dir          = defaults.PATH_DICT['TAXONOMY_TABLES_PARQUET_DIR'],
        novel_dir         = os.path.join(defaults.PATH_DICT['LOSS_ANALYSIS_CSV_DIR'], 'novel_candidates'),
        plot_dir          = defaults.PATH_DICT['LOSS_PLOT_DIR'],
        config_yaml       = defaults.CONFIG_FILE
    threads:
        workflow.cores
    shell:
        '''
        Rscript scripts/taxonomy/loss_analysis.R \
        --ranges_counts_dir {params.ranges_counts_dir:q} \
        --classification_counts_dir {params.class_counts_dir:q} \
        --loci_dir {params.loci_dir:q} \
        --out_parquet {output.table_parquet:q} \
        --out_csv {output.table_csv:q} \
        --novel_dir {params.novel_dir:q} \
        --plot_dir {params.plot_dir:q} \
        --config {params.config_yaml:q}
        '''


rule loss_analysis:
    input:
        rules.loss_analysis_setup.output