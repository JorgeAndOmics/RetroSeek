                         genome=species_with_hits(wildcards)),
        probe_domain_overlap=lambda wildcards: expand(os.path.join(defaults.PATH_DICT['RANGES_ANALYSIS_TABLES_PARQUET_DIR'],'{genome}.probe_domain_overlap.parquet'),
                         genome=species_with_hits(wildcards)),
        reduction_coverage=lambda wildcards: expand(os.path.join(defaults.PATH_DICT['RANGES_ANALYSIS_TABLES_PARQUET_DIR'],'{genome}.reduction_coverage.parquet'),
